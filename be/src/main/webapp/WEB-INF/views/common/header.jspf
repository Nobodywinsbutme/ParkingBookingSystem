<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<c:set var="sp" value="${pageContext.request.servletPath}"/>
<c:set var="homeActive" value="${empty sp or sp eq '/' or fn:length(sp) eq 0}"/>
<c:set var="areasActive" value="${sp eq '/parking-areas'}"/>
<c:set var="dashActive" value="${sp eq '/dashboard'}"/>
<c:set var="bookingsActive" value="${fn:startsWith(sp, '/bookings')}"/>
<c:set var="adminActive" value="${fn:startsWith(sp, '/admin')}"/>
<nav class="navbar navbar-expand-lg navbar-light app-navbar">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" href="${pageContext.request.contextPath}/">
      <i class="bi bi-p-square-fill text-primary fs-4"></i>
      <span>Smart Parking</span>
    </a>
    <button class="navbar-toggler border-0 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
            aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 mt-2 mt-lg-0">
        <li class="nav-item">
          <a class="nav-link ${homeActive ? 'active' : ''}" href="${pageContext.request.contextPath}/">
            <i class="bi bi-house-door me-1"></i>Home
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link ${areasActive ? 'active' : ''}" href="${pageContext.request.contextPath}/parking-areas">
            <i class="bi bi-geo-alt me-1"></i>Parking areas
          </a>
        </li>
        <sec:authorize access="isAuthenticated()">
          <li class="nav-item">
            <a class="nav-link ${dashActive ? 'active' : ''}" href="${pageContext.request.contextPath}/dashboard">
              <i class="bi bi-speedometer2 me-1"></i>Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link ${bookingsActive ? 'active' : ''}" href="${pageContext.request.contextPath}/bookings">
              <i class="bi bi-calendar-check me-1"></i>My bookings
            </a>
          </li>
        </sec:authorize>
        <sec:authorize access="hasRole('ADMIN')">
          <li class="nav-item">
            <a class="nav-link ${adminActive ? 'active' : ''}" href="${pageContext.request.contextPath}/admin">
              <i class="bi bi-shield-lock me-1"></i>Admin
            </a>
          </li>
        </sec:authorize>
      </ul>
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
        <sec:authorize access="!isAuthenticated()">
          <li class="nav-item">
            <a class="nav-link" href="${pageContext.request.contextPath}/login">Sign in</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary btn-sm btn-signin px-3" href="${pageContext.request.contextPath}/register">Register</a>
          </li>
        </sec:authorize>
        <sec:authorize access="isAuthenticated()">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 py-lg-2" href="#" id="userMenuDd"
               role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle fs-4 text-primary"></i>
              <span class="d-none d-md-inline text-truncate" style="max-width: 12rem">
                <sec:authentication property="principal.username"/>
              </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-1" aria-labelledby="userMenuDd">
              <li>
                <span class="dropdown-item-text small text-muted text-truncate" style="max-width: 16rem">
                  <i class="bi bi-envelope me-1"></i>
                  <sec:authentication property="principal.username"/>
                </span>
              </li>
              <li><hr class="dropdown-divider"/></li>
              <li>
                <form class="px-3 py-1" action="${pageContext.request.contextPath}/logout" method="post">
                  <sec:csrfInput/>
                  <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
                    <i class="bi bi-box-arrow-right me-1"></i>Sign out
                  </button>
                </form>
              </li>
            </ul>
          </li>
        </sec:authorize>
      </ul>
    </div>
  </div>
</nav>
